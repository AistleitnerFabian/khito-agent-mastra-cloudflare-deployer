// Local development config for the cloudflare-dev bindings proxy used by `nuxt dev`.
// Keep in sync with wrangler.jsonc, but without `vpc_services` and `migrations`:
// wrangler treats VPC service bindings as remote-only with no local simulator,
// which hangs the bindings proxy and leaves D1, R2, and queue bindings unavailable.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "khito-web",
  "main": "worker/index.ts",
  "assets": {
    "directory": ".output/public"
  },
  "compatibility_date": "2026-08-14",
  "observability": {
    "enabled": true
  },
  "vars": {
    "NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_bm9ibGUtaHVza3ktMC5jbGVyay5hY2NvdW50cy5kZXYk"
  },
  "services": [
    {
      "binding": "KHITO_AGENT",
      "service": "khito-agent"
    }
  ],
  "r2_buckets": [
    {
      "binding": "INBOX_FILES",
      "bucket_name": "khito-sources"
    }
  ],
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_name": "khito_db",
      "database_id": "b54926ee-7e27-4685-88fd-52cdd1474a42",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INBOX_PROCESSING",
        "queue": "khito-inbox-processing"
      }
    ],
    "consumers": [
      {
        "queue": "khito-inbox-processing",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 1,
        "max_retries": 3
      }
    ]
  }
}
