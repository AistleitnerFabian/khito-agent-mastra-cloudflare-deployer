{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "khito-web",
  "main": "worker/index.ts",
  "assets": {
    "directory": ".output/public"
  },
  "compatibility_date": "2026-08-14",
  "observability": {
    "enabled": true
  },
  "vars": {
    "NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_bm9ibGUtaHVza3ktMC5jbGVyay5hY2NvdW50cy5kZXYk"
  },
  "services": [
    {
      "binding": "KHITO_AGENT",
      "service": "khito-agent"
    }
  ],
  "r2_buckets": [
    {
      "binding": "INBOX_FILES",
      "bucket_name": "khito-sources"
    }
  ],
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_name": "khito_db",
      "database_id": "b54926ee-7e27-4685-88fd-52cdd1474a42",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INBOX_PROCESSING",
        "queue": "khito-inbox-processing"
      }
    ],
    "consumers": [
      {
        "queue": "khito-inbox-processing",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DOCLING_CONTAINER",
        "class_name": "DoclingContainer"
      }
    ]
  },
  "containers": [
    {
      "class_name": "DoclingContainer",
      "image": "./worker/containers/docling/Dockerfile",
      "max_instances": 3,
      "instance_type": "standard-2"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DoclingContainer"
      ]
    }
  ]
}
