{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "khito-web",
  "main": ".output/server/index.mjs",
  "assets": {
    "directory": ".output/public"
  },
  "compatibility_date": "2026-08-14",
  "services": [
    {
      "binding": "KHITO_AGENT",
      "service": "khito-agent"
    }
  ],
  "r2_buckets": [
    {
      "binding": "INBOX_FILES",
      "bucket_name": "khito-sources"
    }
  ],
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_name": "khito_db",
      "database_id": "b54926ee-7e27-4685-88fd-52cdd1474a42",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INBOX_PROCESSING",
        "queue": "khito-inbox-processing"
      }
    ]
  }
}
