{
  "name": "khito-agent-platform",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "pnpm --filter @khito/mastra --filter @khito/web --parallel --stream dev",
    "dev:docling": "pnpm --filter @khito/docling-worker dev",
    "dev:mastra": "pnpm --filter @khito/mastra dev",
    "dev:web": "pnpm --filter @khito/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  }
}
